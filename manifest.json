{
  "manifest_version": 3,
  "name": "NexURL-Extractor",
  "version": "1.0.0",
  "description": "Detect every video, audio, and image URL on a page. Filter by type and copy links in one click. By NexApp.",
  "author": "Arabi Islam (MR. ARX)",
  "homepage_url": "https://nexue.vercel.app",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webRequest", "scripting", "activeTab", "tabs", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
